# Qdrant Configuration
# Gunakan http://localhost:6333 jika menjalankan Qdrant via Docker
# Atau kosongkan/isi "local" untuk menggunakan mode embedded lokal
QDRANT_URL=http://localhost:6333

# Inngest Configuration
INNGEST_API_BASE=http://127.0.0.1:8288/v1

# BYOK Server Fallback API Keys (opsional, cukup isi salah satu atau pakai UI BYOK)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Gemini CLI OAuth Fallback (jika tidak memakai API key di atas)
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
